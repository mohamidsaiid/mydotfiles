# Window
background-opacity = 0.95
window-decoration = false
window-padding-x = 8
window-padding-y = 6

# Font
font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 9

# Shell
shell-integration = zsh
command = /bin/zsh

# Cursor
cursor-style = block
cursor-style-blink = true

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Colors
background = 110b18
foreground = dad3ff

cursor-color = dad3ff
cursor-text = 110b18

selection-background = 3b2d60
selection-foreground = f0ebff

# Normal colors
palette = 0=#110b18
palette = 1=#ff3650
palette = 2=#beeaa2
palette = 3=#ffea34
palette = 4=#8168e2
palette = 5=#f053db
palette = 6=#85c8c6
palette = 7=#e1dcff

# Bright colors
palette = 8=#65576b
palette = 9=#ff7a87
palette = 10=#d9ffc7
palette = 11=#fff190
palette = 12=#a49aff
palette = 13=#f09dff
palette = 14=#a8f1ef
palette = 15=#ffffff
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

background-blur = true

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
