# Window
background-opacity = 0.9
window-decoration = false
window-padding-x = 8
window-padding-y = 6

# Font
font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 10.5

# Shell
shell-integration = zsh
command = /bin/zsh

# Cursor
cursor-style = block
cursor-style-blink = true

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Colors
background = 1e1b29
foreground = cfc6ff

# Normal colors
palette = 0=#1e1b29
palette = 1=#ff5c93
palette = 2=#a8ff60
palette = 3=#ffd700
palette = 4=#5a3dad
palette = 5=#a183ff
palette = 6=#00d3d0
palette = 7=#cfc6ff

# Bright colors
palette = 8=#44475a
palette = 9=#ff6e96
palette = 10=#b0ff87
palette = 11=#ffe066
palette = 12=#7b5cf2
palette = 13=#bd99ff
palette = 14=#33f6f4
palette = 15=#ffffff
